#include <iostream>
using namespace std;

class node{
  public:
  int data;
  node* left;
  node* right;
  
  node(int d){
      this->data=d;
      left=NULL;
      right=NULL;
  }
};

node* buildTree(node* root){
    cout<<"Enter data"<<endl;
    int data;
    cin>>data;
    
    if(data==-1)        return NULL;
    root=new node(data);
    
    cout<<"for the left child of "<<data;
    root->left=buildTree(root->left);
    
    cout<<"for the right child of "<<data;
    root->right=buildTree(root->right);
    
    return root;
    
}

int main() {
    node* root=NULL;
     root=buildTree(root);

